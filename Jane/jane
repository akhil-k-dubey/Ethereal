#!/usr/bin/env bash
# =====================================================================
# PROJECT JANE — ONE-COMMAND TERMINAL & 24/7 DAEMON LAUNCHER
# Usage:
#   ./jane                    Launch interactive REPL + live passive ear
#   ./jane --daemon           Run 24/7 sovereign background daemon
#   ./jane --install-service  Install & enable auto-start across laptop reboots
#   ./jane --status           Inspect live 24/7 daemon & campaign telemetry
# =====================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

if [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
    PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python"
elif [ -f "$SCRIPT_DIR/.venv/bin/python3" ]; then
    PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python3"
elif command -v python3 &> /dev/null; then
    PYTHON_BIN="python3"
else
    echo "[Error] python3 not found."
    exit 1
fi

case "${1:-}" in
    --daemon|daemon)
        shift
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scripts/jane_24x7_daemon.py" "$@"
        ;;
    --install-service|install-service)
        exec bash "$SCRIPT_DIR/scripts/enable_24x7_service.sh"
        ;;
    --status|status)
        if [ -f "$SCRIPT_DIR/logs/daemon_status.json" ]; then
            echo "=== Project Jane 24/7 Daemon Telemetry ==="
            cat "$SCRIPT_DIR/logs/daemon_status.json"
            echo ""
        else
            echo "[Jane] No daemon_status.json found yet."
        fi
        if command -v systemctl &> /dev/null; then
            systemctl --user status jane-daemon.service --no-pager || true
        fi
        exit 0
        ;;
    *)
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scripts/interactive_chat.py" "$@"
        ;;
esac
